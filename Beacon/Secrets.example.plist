<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>SUPABASE_URL</key>
    <string>https://YOUR_PROJECT_REF.supabase.co</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>YOUR_ANON_PUBLIC_KEY</string>

    <!--
      Beacon Parser API base URL.
      - iOS Simulator: http://localhost:8000   (default if this key is absent)
      - Physical device: use your Mac's LAN IP (e.g. http://192.168.1.42:8000)
        or a tunnel (ngrok / Tailscale).
      - Production: https://api.beacon.app
    -->
    <key>BACKEND_URL</key>
    <string>http://localhost:8000</string>

    <!--
      Google Sign-In setup (Phase 9.1.5)
      ===================================
      1. Google Cloud Console → APIs & Services → Credentials → Create OAuth
         client ID → iOS. Bundle ID must match PRODUCT_BUNDLE_IDENTIFIER in
         project.yml (com.beacon.app).
      2. Download GoogleService-Info.plist (or copy the values manually).
      3. Copy the iOS client ID into GOOGLE_CLIENT_ID below
         (looks like 1234567890-abcdef.apps.googleusercontent.com).
      4. Copy the REVERSED_CLIENT_ID into Beacon/Info.plist —
         replace REPLACE_WITH_REVERSED_GOOGLE_CLIENT_ID under
         CFBundleURLTypes (looks like com.googleusercontent.apps.1234567890-abcdef).
      5. Backend .env: set GOOGLE_CLIENT_ID to the same iOS client ID.
         Without it, POST /v1/auth/google returns 503.

      Per App Store Review Guideline 4.8, offering Google Sign-In requires
      also offering Apple Sign-In — Beacon ships both, so we're compliant.
    -->
    <key>GOOGLE_CLIENT_ID</key>
    <string>YOUR_IOS_GOOGLE_CLIENT_ID.apps.googleusercontent.com</string>
</dict>
</plist>
