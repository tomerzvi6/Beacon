# Copy to .env and fill in. Never commit .env.

# Deployment environment (development | staging | production).
# Several security checks gate on this — see config.py.
ENVIRONMENT=development

# Short commit SHA surfaced by GET /health for client diagnostics.
# Set this at build/deploy time so /health doesn't have to shell to git.
BEACON_COMMIT=

# Database — local Postgres on localhost:5432
DATABASE_URL=postgresql+psycopg://beacon:beacon_dev@localhost:5432/beacon

# Parser API (Track A — has access to PHI)
ANTHROPIC_API_KEY=
AWS_REGION=eu-central-1
S3_UPLOAD_BUCKET=
APPLE_BUNDLE_ID=com.beacon.app
# iOS OAuth 2.0 client ID from Google Cloud Console — must match the iOS
# bundle ID. Leave empty to disable /v1/auth/google (returns 503).
GOOGLE_CLIENT_ID=
# Local-only escape hatch: defaults to 1 so Google sign-in can be tested
# more easily in development. Ignored in staging/production.
ALLOW_UNSIGNED_GOOGLE_NONCE=1
# REQUIRED in non-development environments. App will refuse to boot if
# ENVIRONMENT != development and this is left at the dev default.
JWT_SIGNING_KEY=
JWT_TTL_SECONDS=2592000

# Agents (Track B — restricted DB role, NO direct PHI access)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=
DASHBOARD_ALLOWED_EMAIL=
